# Pin production installs to a known release. Change this only after reviewing
# the release notes, then run: docker compose -f docker-compose.production.yml pull && docker compose -f docker-compose.production.yml up -d
SEO_PLAYGROUND_VERSION=0.4.0

# Optional: expose the dashboard on a different local port.
# SEO_PLAYGROUND_PORT=3000

# The dashboard has no login and spends your DataForSEO credit, so it only listens on
# this machine by default. Prefer a reverse proxy with authentication; set 0.0.0.0 only
# on a trusted private network.
# SEO_PLAYGROUND_BIND=127.0.0.1

# Optional override for the Geo-grid worker's private internal secret.
# Leave blank to generate and persist one in the data volume.
# CRON_SECRET=
